---
import Base from '../layouts/Base.astro'
import { site } from '../data/site'
---

<Base title={`Not found — ${site.studio}`} description="That route is not in the studio index.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="kicker">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-paper">No drawing for this path.</h1>
    <p class="mt-3 text-mute">The index does not list this route.</p>
    <a class="btn btn-primary mt-8" href="/">Back to studio</a>
  </section>
</Base>
