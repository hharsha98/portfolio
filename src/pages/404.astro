---
import Base from '../layouts/Base.astro'
import { site } from '../data/site'
---

<Base title={`Not found — ${site.studio}`} description="That route is not in the studio catalog.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="kicker">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-paper">This page is not in the catalog.</h1>
    <p class="mt-3 text-mute">Try products, demos, research, or contact.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/products">Products</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </div>
  </section>
</Base>
