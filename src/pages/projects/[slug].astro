---
import Base from '../../layouts/Base.astro'
import { getProject, neighbors, projects } from '../../data/projects'
import { site } from '../../data/site'

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { slug: project.slug },
  }))
}

const { slug } = Astro.props
const project = getProject(slug)!
const { prev, next } = neighbors(project.slug)
const title = `${project.name} — ${site.studio}`
---

<Base title={title} description={project.description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <nav class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute" aria-label="Breadcrumb">
      <a class="hover:text-brass" href="/">Studio</a>
      <span class="px-2" aria-hidden="true">/</span>
      <a class="hover:text-brass" href="/#work">Work</a>
      <span class="px-2" aria-hidden="true">/</span>
      <span class="text-brass">{project.name}</span>
    </nav>

    <p class="mt-10 font-mono text-xs text-brass">{project.index} · {project.statusNote}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper sm:text-5xl">{project.name}</h1>
    <p class="mt-4 text-lg leading-relaxed text-mute">{project.tagline}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {project.github && (
        <a class="btn btn-primary" href={project.github} rel="noreferrer" target="_blank">{project.githubLabel ?? 'GitHub'} ↗</a>
      )}
      {project.demo && (
        <a class="btn btn-ghost" href={project.demo.href} rel="noreferrer" target="_blank">{project.demo.label} ↗</a>
      )}
      {project.secondary && (
        <a class="btn btn-ghost" href={project.secondary.href} rel="noreferrer" target="_blank">{project.secondary.label} ↗</a>
      )}
    </div>

    <div class="mt-12 space-y-5 text-[15px] leading-relaxed text-paper/85">
      {project.body.map((para) => <p>{para}</p>)}
    </div>

    <section class="mt-12">
      <h2 class="kicker">{project.featuresHeading ?? 'In the repo'}</h2>
      <ul class="mt-4 space-y-2 border-l border-line pl-4">
        {project.features.map((f) => (
          <li class="text-sm leading-relaxed text-paper/85">{f}</li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="kicker">Stack</h2>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {project.stack.map((t) => <span class="chip">{t}</span>)}
      </div>
    </section>
  </article>

  <nav class="mx-auto grid max-w-6xl gap-px border-t border-line bg-line sm:grid-cols-2" aria-label="Adjacent projects">
    {prev ? (
      <a href={`/projects/${prev.slug}`} class="bg-ink px-5 py-6 hover:bg-panel sm:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Previous</p>
        <p class="mt-2 text-lg text-paper">{prev.name}</p>
      </a>
    ) : (
      <span class="hidden bg-ink sm:block"></span>
    )}
    {next ? (
      <a href={`/projects/${next.slug}`} class="bg-ink px-5 py-6 text-right hover:bg-panel sm:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Next</p>
        <p class="mt-2 text-lg text-paper">{next.name}</p>
      </a>
    ) : (
      <span class="hidden bg-ink sm:block"></span>
    )}
  </nav>
</Base>
