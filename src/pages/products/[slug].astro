---
import Base from '../../layouts/Base.astro'
import ProductDetail from '../../components/ProductDetail.astro'
import { requireProduct, productPaths } from '../../data/products'
import { site } from '../../data/site'

export function getStaticPaths() {
  return productPaths().map((slug) => ({
    params: { slug },
    props: { slug },
  }))
}

const { slug } = Astro.props
const product = requireProduct(slug)
---

<Base
  title={`${product.name} — ${site.studio}`}
  description={product.description}
  canonical={`/products/${product.slug}`}
>
  <ProductDetail product={product} />
</Base>
