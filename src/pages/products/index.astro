---
import Base from '../../layouts/Base.astro'
import ProductCard from '../../components/ProductCard.astro'
import { site } from '../../data/site'
import { products } from '../../data/products'
const groups = [
  { title: 'Live products', copy: 'Open a working demo and explore the system behind it.', items: products.filter(p => p.status === 'live') },
  { title: 'Local tools', copy: 'Download and run these tools on your own machine.', items: products.filter(p => p.status === 'download') },
  { title: 'In development', copy: 'Early galleries and projects taking shape. Follow the work at its source.', items: products.filter(p => p.status === 'gallery' || p.status === 'building') },
]
---
<Base title={`Products — ${site.studio}`} description="Explore live AI products, local tools, early galleries, and projects taking shape at Agentic Systems Studio.">
  <section class="studio-section">
    <p class="kicker">Studio constellation</p><h1 class="page-title mt-4">Find your next system.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-mute">Coordinate agents. Search knowledge. Inspect the evidence. Every product tells you what you can try today.</p>
    {groups.map(group => group.items.length > 0 && <section class="catalog-section" aria-label={group.title}><h2 class="display text-3xl text-paper">{group.title}</h2><p class="mt-3 mb-7 text-mute">{group.copy}</p><div class="constellation-grid">{group.items.map(product => <ProductCard product={product} />)}</div></section>)}
  </section>
</Base>
