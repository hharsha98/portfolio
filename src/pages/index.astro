---
import Base from '../layouts/Base.astro'
import SystemIndex from '../components/SystemIndex.astro'
import Trace from '../components/Trace.astro'
import CloseBand from '../components/CloseBand.astro'
import { requireProduct, productStatus, type ProductStatus } from '../data/products'

const fleet = requireProduct('agentfleet')
const fleetDemo = fleet.links.find((link) => link.kind === 'live')
const fleetMore = fleet.links.filter((link) => link !== fleetDemo)

const contract: { status: ProductStatus; copy: string }[] = [
  { status: 'live', copy: 'Open it in a browser now. The demo is public and running on a host the studio has checked.' },
  { status: 'download', copy: 'It runs on your machine. Clone the repository or download a release, then start it locally.' },
  { status: 'gallery', copy: 'Screens or a static walkthrough. Something to look at, nothing to run yet.' },
  { status: 'building', copy: 'The source is on GitHub. There is no public link until a host is up and verified.' },
]
---

<Base home>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero-title">
      <span class="line" style="--l:0"><span>Agent systems you can</span></span>
      <span class="line" style="--l:1"><span>open, run, or clone.</span></span>
    </h1>
    <div class="hero-sub">
      <p class="hero-lede">
        Agentic Systems Studio builds multi-agent operations tools, agent environments, and evaluated retrieval.
        Every product below carries its real state: a public demo you can open, a download you run yourself, or work still in progress.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/products">Open the catalog</a>
        <a class="btn btn-ghost" href="/demos">Demos and downloads</a>
      </div>
    </div>

    <SystemIndex />
  </section>

  <section class="flagship" aria-labelledby="flagship-heading">
    {fleet.visual && (
      <figure class="flagship-shot">
        <span class="crop" aria-hidden="true"></span>
        <img
          src={fleet.visual.src}
          alt={fleet.visual.alt}
          width="1200"
          height="1168"
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}
    <div class="flagship-copy">
      <h2 id="flagship-heading" class="section-title">Agent Fleet</h2>
      <p class="flagship-lede">
        A self-hostable platform for a fleet of tool-using agents. Chat with them, or hand the orchestrator a goal
        and watch it split into a task graph with human approval gates.
      </p>
      <dl class="spec">
        <div>
          <dt>Status</dt>
          <dd>Live. The public demo runs on the studio's Contabo server.</dd>
        </div>
        <div>
          <dt>Inside</dt>
          <dd>Orchestrator, document RAG with citations, MCP in both directions, evals and cost budgets.</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{fleet.stack.join(', ')}</dd>
        </div>
      </dl>
      <div class="flagship-actions">
        {fleetDemo && (
          <a class="btn btn-primary" href={fleetDemo.href} rel="noreferrer" target="_blank">
            {fleetDemo.label} <span aria-hidden="true">↗</span>
          </a>
        )}
        {fleetMore.map((link) => (
          <a class="btn btn-ghost" href={link.href} rel="noreferrer" target="_blank">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="contract" aria-labelledby="contract-heading">
    <div class="contract-head">
      <h2 id="contract-heading" class="section-title">The status is the contract.</h2>
      <p>
        A product gets a Live link only when its demo is public and verified. Everything else says what you can
        actually do with it today, and the trace on the index says the same thing.
      </p>
    </div>
    <dl class="contract-list">
      {contract.map((item) => (
        <div class="contract-item">
          <Trace status={item.status} seed={`contract-${item.status}`} class="contract-trace" />
          <dt>{productStatus[item.status]}</dt>
          <dd>{item.copy}</dd>
        </div>
      ))}
    </dl>
  </section>

  <CloseBand />
</Base>
