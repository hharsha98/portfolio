---
import Base from '../layouts/Base.astro'
import Schematic from '../components/Schematic.astro'
import ProductCard from '../components/ProductCard.astro'
import ComingHosts from '../components/ComingHosts.astro'
import { site, paper } from '../data/site'
import { featuredProducts, catalogProducts } from '../data/products'

const featured = featuredProducts()
const rest = catalogProducts()
---

<Base>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-10 sm:px-6 sm:pb-24 sm:pt-16">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute">
      <p class="flex items-center gap-2">
        <span class="led"></span>
        {site.now}
      </p>
      <p>{site.domain}</p>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="kicker">Product studio · AI systems you can run</p>
        <h1 class="title-xl mt-4">
          Agentic
          <span class="block text-brass">Systems</span>
          Studio
        </h1>
        <p class="lede mt-6">
          {site.positioning} Phase 1 products are public: Agent Fleet, Agent OS, Vibespace, and RetrievalLab — plus a catalog of live demos and local tools.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/products">Browse products</a>
          <a class="btn btn-ghost" href="/demos">Demos</a>
          <a class="btn btn-ghost" href={site.github} rel="noreferrer" target="_blank">GitHub ↗</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <Schematic />
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel/40">
    <div class="mx-auto grid max-w-6xl gap-px bg-line sm:grid-cols-3">
      {[
        ['Multi-agent ops', 'Agent Fleet: self-hostable chat, DAG orchestration, RAG, MCP, evals and cost budgets.'],
        ['Agent environments', 'Vibespace and Agent OS — terminal grids, local command centers, dry-run until you flip execution on.'],
        ['Evaluated retrieval', 'RetrievalLab and RAG Trustworthiness: inspect the pipeline, cite a source, or refuse.'],
      ].map(([label, copy]) => (
        <div class="bg-ink px-5 py-7 sm:px-8">
          <p class="kicker">{label}</p>
          <p class="mt-3 text-sm leading-relaxed text-mute">{copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="products" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker">Phase 1</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-paper sm:text-4xl">Featured products</h2>
        <p class="mt-2 max-w-xl text-sm text-mute">
          Working links only. Badges mark Live, Gallery, Download, or GitHub. No invented metrics.
        </p>
      </div>
      <a class="font-mono text-[11px] uppercase tracking-[0.16em] text-brass hover:underline" href="/products">All products →</a>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      {featured.map((p) => <ProductCard product={p} featured />)}
    </div>

    <div class="mt-16 mb-8">
      <p class="kicker">Catalog</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-paper sm:text-3xl">More systems</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {rest.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <ComingHosts />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <article class="frame panel p-6 sm:p-8">
      <span class="frame-b"></span>
      <p class="kicker">Research</p>
      <h2 class="mt-3 max-w-3xl text-2xl font-semibold tracking-tight text-paper sm:text-3xl">
        {paper.title}
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute">{paper.summary}</p>
      <p class="mt-2 font-mono text-[11px] text-mute">{paper.venue} · doi:{paper.doi}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/research">Research note</a>
        <a class="btn btn-ghost" href={paper.doiUrl} rel="noreferrer" target="_blank">DOI ↗</a>
        <a class="btn btn-ghost" href="/products/rag-trustworthiness">Related product</a>
      </div>
    </article>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 sm:px-6">
      <p class="text-sm text-mute">
        Founded by {site.shortName}. Personal site is separate from this studio.
      </p>
      <a class="btn btn-ghost" href={site.profile} rel="noreferrer" target="_blank">About Harsha ↗</a>
    </div>
  </section>
</Base>
