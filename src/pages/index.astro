---
import Base from '../layouts/Base.astro'
import StudioOrbit from '../components/StudioOrbit.astro'
import ProductCard from '../components/ProductCard.astro'
import ComingHosts from '../components/ComingHosts.astro'
import { site, paper } from '../data/site'
import { featuredProducts, catalogProducts, catalogStats } from '../data/products'

const featured = featuredProducts()
const rest = catalogProducts()
const stats = catalogStats()
---

<Base>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner relative mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-6">
        <div class="flex flex-wrap gap-2">
          <span class="pill">Open source</span>
          <span class="pill">Self-hostable</span>
          <span class="pill"><span class="pill-dot"></span> Local-first</span>
        </div>
        <h1 class="title-xl mt-7">
          A studio of AI products
          <span class="gradient-phrase block">you can run and inspect.</span>
        </h1>
        <p class="lede mt-6">
          {site.positioning} Phase 1 is public: Agent Fleet, Agent OS, Vibespace, and RetrievalLab — plus live demos and local tools.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a class="btn btn-primary" href="/products">Browse products →</a>
          <a class="btn-text" href="/demos">See demos</a>
          <a class="btn-text" href={site.github} rel="noreferrer" target="_blank">GitHub ↗</a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <StudioOrbit />
      </div>
    </div>

    <div class="stats-bar">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 sm:grid-cols-4">
        {[
          [String(stats.featured), 'Phase 1 products'],
          [String(stats.catalog), 'In the catalog'],
          [String(stats.live), 'Live demos'],
          [String(stats.download), 'Desktop download'],
        ].map(([value, label]) => (
          <div class="stat-cell">
            <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-mute">{label}</dt>
            <dd class="display text-4xl tracking-tight text-paper sm:text-5xl">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <p class="kicker">Core lines</p>
    <h2 class="display mt-3 max-w-2xl text-3xl leading-tight text-paper sm:text-5xl">
      Ops, environments, and retrieval — as products, not a resume.
    </h2>
    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {[
        ['01', 'Multi-agent ops', 'Agent Fleet: self-hostable chat, DAG orchestration, RAG, MCP, evals and cost budgets.'],
        ['02', 'Agent environments', 'Vibespace and Agent OS — terminal grids, local command centers, dry-run until you flip execution on.'],
        ['03', 'Evaluated retrieval', 'RetrievalLab and RAG Trustworthiness: inspect the pipeline, cite a source, or refuse.'],
      ].map(([index, label, copy]) => (
        <div class="panel px-5 py-7 sm:px-7 sm:py-8">
          <p class="kicker">{index}</p>
          <h3 class="display mt-4 text-2xl text-paper">{label}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mute">{copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="products" class="section pt-0 sm:pt-0">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker">Phase 1</p>
        <h2 class="display mt-2 text-3xl text-paper sm:text-5xl">Featured products</h2>
        <p class="mt-3 max-w-xl text-sm text-mute">
          Working links only. Badges mark Live, Gallery, Download, or GitHub. No invented eval numbers.
        </p>
      </div>
      <a class="btn-text" href="/products">All products →</a>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {featured.map((p) => <ProductCard product={p} featured />)}
    </div>

    <div class="mt-24 mb-8">
      <p class="kicker">Catalog</p>
      <h2 class="display mt-2 text-3xl text-paper sm:text-5xl">More systems</h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {rest.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="section pt-0 sm:pt-0">
    <ComingHosts />
  </section>

  <section class="section pt-0 sm:pt-0">
    <article class="panel p-6 sm:p-10">
      <p class="kicker">Research</p>
      <h2 class="display mt-3 max-w-3xl text-2xl leading-snug text-paper sm:text-4xl">
        {paper.title}
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-mute">{paper.summary}</p>
      <p class="mt-2 font-mono text-[11px] text-mute">{paper.venue} · doi:{paper.doi}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/research">Research note</a>
        <a class="btn btn-ghost" href={paper.doiUrl} rel="noreferrer" target="_blank">DOI ↗</a>
        <a class="btn btn-ghost" href="/products/rag-trustworthiness">Related product</a>
      </div>
    </article>
  </section>

  <section class="border-t border-white/8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-10 sm:px-6">
      <p class="text-sm text-mute">
        Founded by {site.shortName}. Personal site is separate from this studio.
      </p>
      <a class="btn btn-ghost" href={site.profile} rel="noreferrer" target="_blank">About Harsha ↗</a>
    </div>
  </section>
</Base>
