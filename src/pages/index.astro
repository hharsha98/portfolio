---
import Base from '../layouts/Base.astro'
import WorkRow from '../components/WorkRow.astro'
import { site, paper, evehicleshop, hfSpaces } from '../data/site'
import { projects } from '../data/projects'
---

<Base>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 sm:pb-16 sm:pt-12">
    <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <figure class="frame portrait-frame mx-auto max-w-sm lg:mx-0">
          <span class="frame-b"></span>
          <img
            src={site.photo}
            alt={`${site.name}, formal portrait`}
            width="900"
            height="900"
            class="aspect-square w-full object-cover object-top"
          />
        </figure>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Bewerbungsfoto · Nuremberg</p>
      </div>

      <div class="lg:col-span-8">
        <p class="kicker">{site.location}</p>
        <h1 class="title-xl mt-3">
          <span class="block text-[0.32em] font-medium tracking-[0.06em] text-paper/80">Hanumanthu</span>
          Harsha
          <span class="block text-brass">Vardhan</span>
        </h1>
        <p class="lede mt-5">{site.positioning}</p>

        <dl class="mt-8 grid gap-3 border-y border-line py-5 text-sm sm:grid-cols-[9.5rem_1fr]">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Education</dt>
          <dd class="text-paper/90">{site.educationShort}</dd>
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Now</dt>
          <dd class="text-paper/90">{site.now} — {site.nowDetail}. Code is confidential.</dd>
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Paper</dt>
          <dd>
            <a class="text-brass underline-offset-2 hover:underline" href={paper.doiUrl} rel="noreferrer" target="_blank">
              doi:{paper.doi}
            </a>
            <span class="text-mute"> · {paper.venue} · Institute FAPS</span>
          </dd>
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Email</dt>
          <dd>
            <a class="text-brass underline-offset-2 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </dl>

        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>Email</a>
          <a class="btn btn-ghost" href={site.cv}>CV (PDF)</a>
          <a class="btn btn-ghost" href={site.linkedin} rel="noreferrer" target="_blank">LinkedIn ↗</a>
          <a class="btn btn-ghost" href={site.github} rel="noreferrer" target="_blank">GitHub ↗</a>
        </div>
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-mute">
          <li><a class="hover:text-brass" href={site.huggingface} rel="noreferrer" target="_blank">huggingface.co/hharsha</a></li>
          <li><a class="hover:text-brass" href={evehicleshop.href} rel="noreferrer" target="_blank">{evehicleshop.label}</a></li>
          <li><a class="hover:text-brass" href="/about">Full CV trail</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="work" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="kicker">Work</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-paper sm:text-4xl">Public systems</h2>
          <p class="mt-2 max-w-2xl text-sm text-mute">
            Real URLs only. GitHub is <a class="text-brass underline-offset-2 hover:underline" href={site.github} rel="noreferrer" target="_blank">github.com/hharsha98</a>.
            No star counts. Siemens thesis source is not public.
          </p>
        </div>
        <p class="font-mono text-[11px] text-mute">{projects.length} repos · plus {evehicleshop.name}</p>
      </div>

      <div class="divide-y divide-line border-y border-line">
        {projects.map((p) => <WorkRow project={p} />)}
        <article class="grid gap-3 py-5 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
          <p class="font-mono text-[11px] text-brass">EV</p>
          <div>
            <h3 class="text-lg font-semibold tracking-tight text-paper">{evehicleshop.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-mute">{evehicleshop.note}</p>
          </div>
          <div class="flex flex-wrap gap-2 sm:justify-end">
            <a class="btn btn-ghost px-3 py-2 text-xs" href={evehicleshop.href} rel="noreferrer" target="_blank">Live site ↗</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <article class="frame panel p-6 sm:p-8">
        <span class="frame-b"></span>
        <p class="kicker">Paper</p>
        <h2 class="mt-3 max-w-3xl text-2xl font-semibold tracking-tight text-paper sm:text-3xl">
          {paper.title}
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute">{paper.summary}</p>
        <p class="mt-2 font-mono text-[11px] text-mute">{paper.venue} · doi:{paper.doi}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={paper.doiUrl} rel="noreferrer" target="_blank">DOI ↗</a>
          <a class="btn btn-ghost" href="/research">Research note</a>
          <a class="btn btn-ghost" href={paper.researchgate} rel="noreferrer" target="_blank">ResearchGate ↗</a>
        </div>
      </article>

      <div class="mt-8">
        <p class="kicker">Hugging Face</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {hfSpaces.map((s) => (
            <li class="panel p-4">
              <a class="font-medium text-paper hover:text-brass" href={s.href} rel="noreferrer" target="_blank">{s.name} ↗</a>
              <p class="mt-1 text-sm text-mute">{s.note}</p>
            </li>
          ))}
        </ul>
        <p class="mt-3 font-mono text-[11px] text-mute">
          Profile: <a class="hover:text-brass" href={site.huggingface} rel="noreferrer" target="_blank">{site.huggingface.replace('https://', '')}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
