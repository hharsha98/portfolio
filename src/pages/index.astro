---
import Base from '../layouts/Base.astro'
import ProductStage from '../components/ProductStage.astro'
import WorkflowVisual from '../components/WorkflowVisual.astro'
import ProductCard from '../components/ProductCard.astro'
import StudioMark from '../components/StudioMark.astro'
import { site, paper } from '../data/site'
import { products, requireProduct } from '../data/products'
import type { ShowcaseKind } from '../data/showcase'
const spotlights: { slug: string; kind: ShowcaseKind; eyebrow: string; title: string; copy: string; capabilities: string[] }[] = [
  { slug: 'agentfleet', kind: 'coordinate', eyebrow: 'Agent orchestration', title: 'Give the work a team.', copy: 'Bring agents, missions, documents, and workflows into one place. Follow the work, inspect the result, and stay in control.', capabilities: ['Multi-agent chat', 'Workflow orchestration', 'Human approval'] },
  { slug: 'retrievallab', kind: 'retrieve', eyebrow: 'Retrieval, made visible', title: 'Watch knowledge become useful.', copy: 'Look inside retrieval. Explore contextual chunks, hybrid search, and reranking, then compare the evidence behind the answer.', capabilities: ['Contextual chunking', 'Hybrid search + reranking', 'Retrieval evaluation'] },
  { slug: 'rag-trustworthiness', kind: 'verify', eyebrow: 'Trust through evidence', title: 'An answer is only the beginning.', copy: 'Inspect citations and claim-level evidence. See where an answer is supported, where it contradicts a source, and when the system should decline.', capabilities: ['Claim-level entailment', 'Citation inspection', 'Grounding + abstention'] },
]
const spotlightSlugs = new Set(spotlights.map(item => item.slug))
const otherLive = products.filter(p => p.status === 'live' && !spotlightSlugs.has(p.slug))
const local = products.filter(p => p.status === 'download')
const developing = products.filter(p => p.status === 'gallery' || p.status === 'building')
---
<Base home>
  <section class="showcase-hero" aria-labelledby="studio-headline" data-motion>
    <div class="hero-haze ambient" aria-hidden="true"></div>
    <div class="hero-copy-new" data-reveal>
      <p class="hero-eyebrow"><span aria-hidden="true"></span>Independent AI product studio</p>
      <h1 id="studio-headline">Agentic systems.<br /><span>Built to run.</span></h1>
      <p class="hero-summary">Explore working AI products for coordinating agents, searching knowledge, and checking answers against evidence.</p>
      <div class="hero-actions"><a class="btn btn-light" href="/products">Explore all products <span aria-hidden="true">↗</span></a><a class="btn btn-ghost" href="/demos">See demos <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-stage-wrap" data-reveal><ProductStage /></div>
    <p class="hero-bottom-note">Built by Harsha Vardhan <span aria-hidden="true">/</span> Open source. Working demos. Inspectable systems.</p>
  </section>

  <section class="studio-section live-showcases" aria-labelledby="constellation-title">
    <div class="section-heading" data-reveal><p class="kicker">Studio constellation</p><h2 id="constellation-title">Ideas you can<br /><span>actually open.</span></h2><p>Working products, each with a purpose. Go straight to a demo or explore how it was built.</p></div>
    {spotlights.map((item, i) => {
      const product = requireProduct(item.slug)
      const live = product.links.find(link => link.kind === 'live')!
      return <article class:list={['product-spotlight', `spotlight-${item.kind}`, i % 2 === 1 && 'spotlight-reverse']} data-reveal>
        <div class="spotlight-copy"><div class="spotlight-overline"><span>{product.name}</span><span class="badge badge-live">Live</span></div><p class="kicker">{item.eyebrow}</p><h3>{item.title}</h3><p>{item.copy}</p><ul class="capability-list">{item.capabilities.map(cap => <li><span aria-hidden="true">✓</span>{cap}</li>)}</ul><div class="spotlight-actions"><a class="btn btn-light" href={live.href} target="_blank" rel="noreferrer">{live.label === 'Live demo / Contabo' ? live.label : `Open ${product.name === 'RAG Trustworthiness Industrial' ? 'RAG Trust' : product.name}`} ↗</a><a class="catalog-link" href={product.github} target="_blank" rel="noreferrer">Source ↗</a><a class="catalog-link" href={`/products/${product.slug}`}>Details →</a></div></div>
        <div class="spotlight-visual"><WorkflowVisual kind={item.kind} compact /></div>
      </article>
    })}
    <div class="other-live">{otherLive.map(p => <ProductCard product={p} compact />)}</div>
  </section>

  <section class="evidence-section" aria-labelledby="evidence-title"><div class="studio-section">
    <div class="section-heading" data-reveal><p class="kicker">Beyond the interface</p><h2 id="evidence-title">Engineering<br /><span>you can inspect.</span></h2><p>Follow the implementation, question the evaluation, and read the research behind the work.</p></div>
    <div class="evidence-grid">
      <a class="evidence-card" href="https://github.com/hharsha98/agentfleet/blob/main/docs/DEPLOY.md" target="_blank" rel="noreferrer" data-reveal><span class="evidence-symbol" aria-hidden="true">↗</span><p class="kicker">Build & run</p><h3>From source<br />to a running system.</h3><p>Inspect Agent Fleet’s application code and self-host deployment instructions.</p><div class="evidence-tech">FastAPI · Next.js · PostgreSQL</div><span class="catalog-link">Read deployment docs ↗</span></a>
      <a class="evidence-card" href="https://retrievallab.pages.dev/eval" target="_blank" rel="noreferrer" data-reveal><span class="evidence-symbol" aria-hidden="true">≋</span><p class="kicker">Evaluate</p><h3>Compare retrieval.<br />Inspect the trade-offs.</h3><p>Explore naive and advanced retrieval against the lab’s labelled demo corpus.</p><div class="evidence-tech">pgvector · BM25 · FlashRank</div><span class="catalog-link">Open retrieval evaluation ↗</span></a>
      <a class="evidence-card" href="https://github.com/hharsha98/rag-trustworthiness-industrial/blob/main/METRICS.md" target="_blank" rel="noreferrer" data-reveal><span class="evidence-symbol" aria-hidden="true">✓</span><p class="kicker">Verify</p><h3>Make the definition<br />of trust explicit.</h3><p>Read how RAG Trust defines its metrics, aggregation, and grounding decisions.</p><div class="evidence-tech">Ollama · FAISS · Entailment</div><span class="catalog-link">Read the metric definitions ↗</span></a>
    </div>
    <article class="research-feature" data-reveal><div><p class="kicker">Published research · {paper.venue}</p><h3>{paper.title}</h3></div><div><p>{paper.summary}</p><div class="spotlight-actions"><a class="catalog-link" href="/research">Research note →</a><a class="catalog-link" href={paper.doiUrl} target="_blank" rel="noreferrer">Read the publication ↗</a></div></div></article>
  </div></section>

  <section class="studio-section workshop" aria-labelledby="workshop-title">
    <div class="section-heading" data-reveal><p class="kicker">The workshop</p><h2 id="workshop-title">Local tools.<br /><span>Next possibilities.</span></h2><p>Download what runs on your machine. Explore early galleries and follow the projects taking shape.</p></div>
    <div class="local-tools">{local.map(p => <ProductCard product={p} compact />)}</div>
    <div class="workshop-heading"><h3>In development</h3><a class="catalog-link" href="/products">Explore the full catalog →</a></div>
    <div class="workshop-grid">{developing.map(p => <ProductCard product={p} compact />)}</div>
  </section>

  <section class="founder-close studio-section" aria-labelledby="founder-title" data-reveal><div class="founder-stamp"><StudioMark size={80} /><p>Independent by design.<br />Open by default.</p></div><div><p class="kicker">Meet the builder</p><h2 id="founder-title">Built with intent.<br />By Harsha Vardhan.</h2><p>I build agent systems and retrieval products with an emphasis on work you can run, inspect, and evaluate.</p><div class="spotlight-actions"><a class="btn btn-light" href="/contact">Write the studio ↗</a><a class="catalog-link" href={site.profile} target="_blank" rel="noreferrer">About Harsha ↗</a></div><a class="contact-address" href={`mailto:${site.email}`}>{site.email}</a></div></section>
</Base>
