---
import Base from '../layouts/Base.astro'
import { paper, site } from '../data/site'
---

<Base
  title={`Research — ${site.studio}`}
  description={paper.title}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="kicker">Research</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-paper sm:text-5xl">
      Local retrieval, industrial trust
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-mute">
      Conference paper from the FAPS research assistantship: retrieval that stays on local knowledge, scored with trustworthiness metrics rather than fluency alone.
    </p>

    <div class="frame panel mt-10 p-6 sm:p-8">
      <span class="frame-b"></span>
      <dl class="grid gap-4 font-mono text-[12px] sm:grid-cols-[7rem_1fr]">
        <dt class="uppercase tracking-[0.16em] text-mute">Title</dt>
        <dd class="font-sans text-base leading-snug text-paper">{paper.title}</dd>
        <dt class="uppercase tracking-[0.16em] text-mute">Context</dt>
        <dd class="font-sans text-base text-paper/85">{paper.context}</dd>
        <dt class="uppercase tracking-[0.16em] text-mute">Place</dt>
        <dd class="font-sans text-base text-paper/85">Institute FAPS, Nuremberg · FAU</dd>
      </dl>
      <p class="mt-6 text-[15px] leading-relaxed text-paper/85">{paper.summary}</p>
      <p class="mt-4 text-sm leading-relaxed text-mute">
        The assistantship work used local embedding models, retrieval pipelines, prototype agent workflows, and reliability evaluation for industrial decision support. This page does not invent venue names, acceptance rates, or scores that are not on the public record.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={paper.url} rel="noreferrer" target="_blank">Open on ResearchGate ↗</a>
        <a class="btn btn-ghost" href="/projects/retrievallab">Related: RetrievalLab</a>
      </div>
    </div>
  </article>
</Base>
