---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'

interface Props {
  title?: string
  description?: string
  canonical?: string
  home?: boolean
}

const title = Astro.props.title ?? site.title
const description = Astro.props.description ?? site.description
const home = Astro.props.home ?? false
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, site.url).toString()
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.studio,
  url: site.url,
  email: `mailto:${site.email}`,
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nuremberg',
    addressCountry: 'DE',
  },
  founder: {
    '@type': 'Person',
    name: site.name,
    url: site.profile,
    sameAs: [site.github, site.profile, site.linkedin, site.huggingface],
  },
  sameAs: [site.github],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e2e33" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.studio} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Play the power-on sequence once per visit; later pages in the session open settled.
      try {
        if (sessionStorage.getItem('studio-booted')) document.documentElement.dataset.booted = ''
        else sessionStorage.setItem('studio-booted', '1')
      } catch {}
    </script>
  </head>
  <body class:list={[home && 'is-home']}>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
