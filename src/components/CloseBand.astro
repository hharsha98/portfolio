---
import { site } from '../data/site'
---

<section class="close-band" aria-labelledby="close-heading">
  <div class="close-glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker">Contact</p>
    <h2 id="close-heading" class="display mt-4 max-w-4xl text-5xl leading-[1.02] text-paper sm:text-7xl">
      Write the studio
      <span class="gradient-phrase block">or clone the work.</span>
    </h2>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-mute">
      {site.email} and GitHub are the doors. This hub is not a product login wall.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a class="btn btn-light" href="/contact">Contact form</a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn btn-ghost" href={site.github} rel="noreferrer" target="_blank">GitHub ↗</a>
    </div>
  </div>
</section>
