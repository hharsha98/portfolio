---
import { futureHosts } from '../data/site'
---

<aside class="frame panel p-5 sm:p-6">
  <span class="frame-b"></span>
  <p class="kicker">Studio hosts · coming</p>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute">
    These product URLs are reserved in copy and config. They are not live yet — primary buttons still go to GitHub, galleries, downloads, and working demos.
  </p>
  <ul class="mt-5 grid gap-2 sm:grid-cols-2">
    {futureHosts.map((item) => (
      <li class="border border-line bg-ink/40 px-3 py-2">
        <p class="font-mono text-[11px] text-brass">{item.host}</p>
        <p class="mt-1 text-sm text-paper">{item.product}</p>
      </li>
    ))}
  </ul>
</aside>
