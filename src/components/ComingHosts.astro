---
import { futureHosts } from '../data/site'
---

<aside class="panel p-6 sm:p-8">
  <p class="kicker">Studio hosts · planned</p>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute">
    These names are reserved in copy and config only. None of them are live. Do not treat them as product URLs. Buttons go to GitHub, galleries, downloads, and owned demos.
  </p>
  <ul class="mt-5 grid gap-2 sm:grid-cols-2">
    {futureHosts.map((item) => (
      <li class="rounded-xl border border-line bg-ink/40 px-3 py-3">
        <p class="font-mono text-[11px] text-brass">{item.host}</p>
        <p class="mt-1 text-sm text-paper">{item.product}</p>
      </li>
    ))}
  </ul>
</aside>
