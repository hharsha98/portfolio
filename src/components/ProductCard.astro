---
import type { Product } from '../data/products'
import { badgeLinks, statusLabel } from '../data/products'

interface Props {
  product: Product
  featured?: boolean
  compact?: boolean
  class?: string
}

const { product, featured = false, compact = false, class: className } = Astro.props
const href = `/products/${product.slug}`
const badges = badgeLinks(product)
const showArt = featured && !compact
const accent = /^#[0-9a-fA-F]{6}$/.test(product.accent) ? product.accent : '#8b7cff'
---

<article
  class:list={[
    'product-card has-accent panel flex h-full flex-col p-5 sm:p-6',
    featured && 'product-card-featured sm:p-7',
    compact && 'constellation-card',
    className,
  ]}
  style={`--accent:${accent}`}
>
  {featured && !compact && (
    <span class="star-index" aria-hidden="true">{product.index}</span>
  )}
  {product.visual && showArt ? (
    <a class="product-shot mb-5 block" href={href}>
      <img
        src={product.visual.src}
        alt={product.visual.alt}
        width="1200"
        height="1168"
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : showArt ? (
    <a class="product-shot product-art mb-5" href={href}>
      <span class="art-panes" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="art-copy">
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-mute">{product.index}</span>
        <span class="display mt-1 block text-2xl text-paper">{product.name}</span>
      </span>
    </a>
  ) : null}

  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="font-mono text-[11px]" style={`color:var(--accent)`}>{product.index}</span>
    <span class={`badge badge-${product.status}`}>{statusLabel(product.status)}</span>
  </div>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {badges.map((link) => (
      <a
        class={`badge badge-${link.kind}`}
        href={link.href}
        rel="noreferrer"
        target="_blank"
      >
        {link.label}
      </a>
    ))}
  </div>

  <h3 class:list={['mt-4 tracking-tight text-paper', featured && !compact ? 'display text-3xl' : 'text-xl font-medium']}>
    <a class="product-name-link" href={href}>{product.name}</a>
  </h3>
  <p class="mt-2 max-w-2xl flex-1 text-sm leading-relaxed text-mute">
    {product.description}
  </p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {product.stack.slice(0, featured && !compact ? 6 : 4).map((t) => (
      <span class="chip">{t}</span>
    ))}
  </div>
  <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.16em]" style={`color:var(--accent)`}>
    <a href={href}>Open product →</a>
  </p>
</article>
