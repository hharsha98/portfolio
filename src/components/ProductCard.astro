---
import type { Product } from '../data/products'
import { statusLabel } from '../data/products'
interface Props { product: Product; featured?: boolean; compact?: boolean; class?: string }
const { product, class: className } = Astro.props
const primary = product.links.find(link => ['live', 'download', 'gallery'].includes(link.kind)) ?? product.links.find(link => link.kind === 'github')!
const secondary = product.links.filter(link => link.href !== primary.href)
---
<article class:list={['catalog-card product-card has-accent panel flex h-full flex-col p-5 sm:p-6', className]} data-reveal>
  <div><span class={`badge badge-${product.status}`}>{statusLabel(product.status)}</span></div>
  <h3 class="mt-5 text-xl font-medium text-paper"><a class="product-name-link" href={`/products/${product.slug}`}>{product.name}</a></h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-mute">{product.description}</p>
  <div class="mt-5 flex flex-wrap gap-1.5">{product.stack.slice(0, 3).map(t => <span class="chip">{t}</span>)}</div>
  <div class="catalog-card-actions mt-5"><a class="btn btn-ghost" href={primary.href} target="_blank" rel="noreferrer">{primary.label} ↗</a><a class="catalog-link" href={`/products/${product.slug}`}>Open product →</a></div>
  {secondary.length > 0 && <div class="catalog-card-actions mt-2">{secondary.map(link => <a class="catalog-link" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>}
</article>
