---
// One source of geometry for the favicon and every in-page Studio mark.
import mark from '../../public/favicon.svg?raw'

interface Props {
  size?: number
  class?: string
}
const { size = 36, class: className } = Astro.props
---

<span
  class:list={['studio-mark', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
  set:html={mark}
/>

<style>
  .studio-mark { display: inline-flex; flex: none; }
  .studio-mark :global(svg) { display: block; width: 100%; height: 100%; }
</style>
