---
import { credibilityStack } from '../data/products'
---

<section class="tech-band" aria-labelledby="tech-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="kicker">Stack</p>
    <h2 id="tech-heading" class="display mt-3 text-4xl text-paper sm:text-5xl">Tech we actually use</h2>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-mute">
      Names from the public catalogs and this hub — not a vendor wall, not invented eval scores.
    </p>
    <ul class="mt-8 flex flex-wrap gap-2">
      {credibilityStack.map((item) => (
        <li class="tech-pill">{item}</li>
      ))}
    </ul>
  </div>
</section>
