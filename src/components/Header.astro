---
import { site, nav } from '../data/site'
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex min-h-11 items-center gap-3">
      <span class="logo-mark" aria-hidden="true">A·S</span>
      <span class="leading-tight">
        <span class="block text-sm text-paper group-hover:text-brass">{site.studio}</span>
        <span class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-mute sm:block">Product studio</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((item) => {
        const active = path === item.href || path.startsWith(`${item.href}/`)
        return (
          <a
            href={item.href}
            class:list={[
              'min-h-11 px-3 py-2 text-[13px] tracking-wide transition-colors',
              active ? 'text-paper' : 'text-mute hover:text-paper',
            ]}
          >
            {item.label}
          </a>
        )
      })}
      <a
        href={site.profile}
        rel="noreferrer"
        target="_blank"
        class="ml-1 min-h-11 rounded-full px-3 py-2 text-[13px] tracking-wide text-mute hover:text-brass"
      >
        Founder
      </a>
      <a class="btn btn-primary header-cta ml-2" href="/products">Browse products</a>
    </nav>

    <details class="nav-menu relative md:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-lg border border-line text-paper">
        <span class="sr-only">Menu</span>
        <span aria-hidden="true" class="font-mono text-xs">☰</span>
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-line bg-panel p-2 shadow-xl">
        {nav.map((item) => (
          <a href={item.href} class="block min-h-11 rounded-lg px-3 py-3 text-sm text-paper hover:text-brass">
            {item.label}
          </a>
        ))}
        <a href={site.profile} rel="noreferrer" target="_blank" class="block min-h-11 rounded-lg px-3 py-3 text-sm text-paper hover:text-brass">
          Founder
        </a>
      </div>
    </details>
  </div>
</header>
