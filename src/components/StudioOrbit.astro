---
import { products, statusLabel } from '../data/products'

const layout: Record<string, { a: number; r: number }> = {
  retrievallab: { a: -22, r: 37 },
  careeragent: { a: 18, r: 41 },
  'rag-trustworthiness': { a: 54, r: 34 },
  'agent-os': { a: 94, r: 39 },
  vibespace: { a: 132, r: 33 },
  agentgrid: { a: 168, r: 42 },
  'mara-open': { a: 204, r: 30 },
  'revenue-ops': { a: 246, r: 36 },
  'agentops-studio': { a: 286, r: 32 },
  agentfleet: { a: 328, r: 40 },
}

const nodes = products.map((product) => {
  const pos = layout[product.slug]
  if (!pos) throw new Error(`constellation layout missing: ${product.slug}`)
  return { product, ...pos }
})

const stars = [
  { a: 8, r: 46 },
  { a: 76, r: 47 },
  { a: 118, r: 45 },
  { a: 190, r: 48 },
  { a: 230, r: 46 },
  { a: 270, r: 47 },
  { a: 310, r: 45 },
  { a: 350, r: 48 },
] as const
---

<figure class="studio-orbit-wrap">
  <div class="orbit-stage">
    <div class="studio-orbit">
      <div class="orbit-glow" aria-hidden="true"></div>
      <div class="orbit-rings" aria-hidden="true">
        <span class="orbit-ring orbit-ring-a"></span>
        <span class="orbit-ring orbit-ring-b"></span>
        <span class="orbit-ring orbit-ring-c"></span>
        <span class="orbit-ring orbit-ring-d"></span>
      </div>

      {stars.map((star) => (
        <span class="orbit-star" style={`--a:${star.a}deg;--r:${star.r}`} aria-hidden="true"></span>
      ))}

      <a class="orbit-core" href="/products" aria-label="Browse studio products">
        <span class="orbit-core-mark">A·S</span>
        <span class="orbit-core-sub">Studio</span>
      </a>

      {nodes.map((node) => (
        <a
          class:list={['orbit-node', `is-${node.product.status}`]}
          href={`/products/${node.product.slug}`}
          style={`--a:${node.a}deg;--r:${node.r};--c:${node.product.accent}`}
          aria-label={`${node.product.name} — ${statusLabel(node.product.status)}`}
        >
          <span class="orbit-mark">{node.product.index}</span>
          <span class="orbit-label">{node.product.name}</span>
        </a>
      ))}
    </div>
  </div>
  <figcaption class="orbit-caption">
    Studio constellation — {products.length} products around one core.
  </figcaption>
</figure>
