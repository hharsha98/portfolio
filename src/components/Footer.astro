---
import { site, nav } from '../data/site'
import StudioMark from './StudioMark.astro'
---
<footer class="studio-footer border-t border-line">
  <div class="mx-auto grid max-w-[1256px] gap-10 px-5 py-14 sm:px-8 md:grid-cols-3">
    <div><a class="brand-link flex items-center gap-3 text-paper" href="/"><StudioMark size={32} /><span class="font-medium">{site.studio}</span></a><p class="mt-5 max-w-xs text-sm leading-relaxed">Working AI products. Open implementation. Evidence you can inspect.</p></div>
    <nav aria-label="Footer" class="flex flex-wrap content-start gap-x-6 gap-y-1">{nav.map(item => <a class="catalog-link" href={item.href}>{item.label}</a>)}<a class="catalog-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></nav>
    <div><p class="text-sm text-paper">Built by Harsha Vardhan</p><p class="mt-2 text-sm">{site.location}</p><a class="catalog-link" href={site.profile} target="_blank" rel="noreferrer">Founder ↗</a><br /><a class="contact-address" href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
  <p class="border-t border-line px-5 py-5 text-center text-xs text-mute">© {new Date().getFullYear()} {site.studio}</p>
</footer>
