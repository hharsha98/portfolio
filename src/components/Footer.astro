---
import Logo from './Logo.astro'
import { site, nav } from '../data/site'

const home = (Astro.url.pathname.replace(/\/$/, '') || '/') === '/'
---

<footer class="site-footer">
  {!home && (
    <div class="footer-contact">
      <p class="footer-contact-title">Write the studio.</p>
      <div class="footer-contact-actions">
        <a class="btn btn-primary" href="/contact">Contact form</a>
        <button
          type="button"
          class="btn btn-ghost"
          data-copy={site.email}
          data-label={site.email}
          aria-label={`Copy email ${site.email}`}
        >
          {site.email}
        </button>
      </div>
    </div>
  )}
  <div class="footer-inner">
    <div class="footer-brand">
      <Logo size={24} />
      <p>
        Agent systems shipped over time: live demos, local downloads, and work still being built. Source on
        <a href={site.github} rel="noreferrer" target="_blank">github.com/hharsha98</a>.
      </p>
    </div>
    <ul class="footer-links" aria-label="Studio">
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href={site.github} rel="noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a href={site.profile} rel="noreferrer" target="_blank">Founder <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
  <p class="footer-base">
    <span>© {new Date().getFullYear()} {site.studio}</span>
    <span>{site.location}</span>
  </p>
</footer>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy]')
  buttons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy
      const original = btn.dataset.label ?? btn.textContent ?? ''
      if (!value) return
      try {
        await navigator.clipboard.writeText(value)
        btn.textContent = 'Copied'
        window.setTimeout(() => {
          btn.textContent = original
        }, 1600)
      } catch {
        window.location.href = `mailto:${value}`
      }
    })
  })
</script>
