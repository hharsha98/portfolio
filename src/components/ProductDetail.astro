---
import type { Product } from '../data/products'
import { neighbors } from '../data/products'

interface Props {
  product: Product
}

const { product } = Astro.props
const { prev, next } = neighbors(product.slug)
const primary = product.links.find((l) => l.kind !== 'github') ?? product.links[0]
const rest = product.links.filter((l) => l !== primary)
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  <nav class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute" aria-label="Breadcrumb">
    <a class="hover:text-brass" href="/">Home</a>
    <span class="px-2" aria-hidden="true">/</span>
    <a class="hover:text-brass" href="/products">Products</a>
    <span class="px-2" aria-hidden="true">/</span>
    <span class="text-brass">{product.name}</span>
  </nav>

  <p class="mt-10 font-mono text-xs text-brass">{product.index} · {product.statusNote}</p>
  <h1 class="page-title mt-3">{product.name}</h1>
  <p class="mt-4 text-lg leading-relaxed text-mute">{product.tagline}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    {primary && (
      <a class="btn btn-primary" href={primary.href} rel="noreferrer" target="_blank">{primary.label} ↗</a>
    )}
    {rest.map((link) => (
      <a class="btn btn-ghost" href={link.href} rel="noreferrer" target="_blank">{link.label} ↗</a>
    ))}
  </div>

  {product.futureHost && (
    <p class="mt-6 font-mono text-[11px] leading-relaxed text-mute">
      Coming on <span class="text-paper">{product.futureHost}</span> — DNS is not attached yet, so the buttons above use the working GitHub / demo links.
    </p>
  )}

  {product.visual && (
    <figure class="product-shot mt-10">
      <img src={product.visual.src} alt={product.visual.alt} class="!h-auto max-h-[28rem] object-cover object-top" />
      <figcaption class="border-t border-white/8 px-4 py-3 font-mono text-[11px] text-mute">
        Owned product landing from the public repo — not a hosted SaaS URL.
      </figcaption>
    </figure>
  )}

  <div class="mt-12 space-y-5 text-[15px] leading-relaxed text-paper/85">
    {product.body.map((para) => <p>{para}</p>)}
  </div>

  <section class="mt-12">
    <h2 class="kicker">{product.featuresHeading ?? 'In the product'}</h2>
    <ul class="mt-4 space-y-2 border-l border-line pl-4">
      {product.features.map((f) => (
        <li class="text-sm leading-relaxed text-paper/85">{f}</li>
      ))}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="kicker">Stack</h2>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {product.stack.map((t) => <span class="chip">{t}</span>)}
    </div>
  </section>
</article>

<nav class="mx-auto grid max-w-6xl gap-px border-t border-line bg-line sm:grid-cols-2" aria-label="Adjacent products">
  {prev ? (
    <a href={`/products/${prev.slug}`} class="bg-ink px-5 py-6 hover:bg-panel sm:px-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Previous</p>
      <p class="mt-2 text-lg text-paper">{prev.name}</p>
    </a>
  ) : (
    <span class="hidden bg-ink sm:block"></span>
  )}
  {next ? (
    <a href={`/products/${next.slug}`} class="bg-ink px-5 py-6 text-right hover:bg-panel sm:px-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Next</p>
      <p class="mt-2 text-lg text-paper">{next.name}</p>
    </a>
  ) : (
    <span class="hidden bg-ink sm:block"></span>
  )}
</nav>
