---
const steps = [
  {
    index: '01',
    title: 'Brief',
    copy: 'Write the studio, or open a public repo. There is no account wall and no login funnel.',
  },
  {
    index: '02',
    title: 'Dispatch',
    copy: 'Ops, environments, or evaluated retrieval — the line that matches the job, not a single app.',
  },
  {
    index: '03',
    title: 'Surface',
    copy: 'Live lab, desktop download, early gallery, or a repo still being built. The badge is the contract.',
  },
  {
    index: '04',
    title: 'Inspect',
    copy: 'Source, self-host docs, or a public demo. If it is not live, the card says so.',
  },
] as const
---

<section class="section pt-0 sm:pt-0" aria-labelledby="workflow-heading">
  <p class="kicker">How work moves</p>
  <h2 id="workflow-heading" class="display mt-3 max-w-2xl text-3xl leading-tight text-paper sm:text-5xl">
    Studio workflow
  </h2>
  <p class="mt-4 max-w-xl text-sm leading-relaxed text-mute">
    A brief lands here. You pick a product by status — then you run it, clone it, or wait until it is honest to click Live.
  </p>

  <ol class="workflow">
    {steps.map((step) => (
      <li class="workflow-step">
        <span class="workflow-node" aria-hidden="true">{step.index}</span>
        <h3 class="display mt-5 text-2xl text-paper">{step.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-mute">{step.copy}</p>
      </li>
    ))}
  </ol>
</section>
