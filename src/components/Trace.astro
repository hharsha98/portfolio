---
import { tracePath, PERIOD, HEIGHT } from '../lib/traces'
import type { ProductStatus } from '../data/products'

interface Props {
  status: ProductStatus
  seed: string
  class?: string
}

const { status, seed, class: className } = Astro.props
const shape = status === 'live' ? 'running' : status === 'download' ? 'stepped' : 'dotted'
---

<span class:list={['trace', className]} data-trace={shape} aria-hidden="true">
  <svg class="trace-strip" viewBox={`0 0 ${PERIOD * 2} ${HEIGHT}`} preserveAspectRatio="none" focusable="false">
    <path d={tracePath(status, seed)}></path>
  </svg>
</span>
