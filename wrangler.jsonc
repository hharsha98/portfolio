{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-systems-studio",
  // Static assets Worker. Bind agentic-systems-studio.com later in the
  // Cloudflare dashboard (Workers & Pages → Custom domains). Do not put
  // routes.custom_domain here until the zone is attached to this account.
  "compatibility_date": "2026-08-31",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
}
